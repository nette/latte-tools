Test: "defined" support for macros

{import $_self}
{import $_self}

{if method_exists($macros[macros], hello)}
    OK
{/if}

{if !method_exists($macros[macros], foo)}
    OK
{/if}

{if method_exists($macros[__internal_%h%], hello)}
    OK
{/if}

{if !method_exists($macros[__internal_%h%], bar)}
    OK
{/if}

{if !isset($foo)}
    OK
{/if}

{define hello, $name}
    Hello {$name}
{/define}
